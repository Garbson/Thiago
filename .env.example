# Copie para .env e preencha. Nunca suba o .env para o git.
PORT=3011
HOST=127.0.0.1
# Endereço público do site, usado nos links e fotos do feed dos portais
PUBLIC_URL=https://seudominio.com.br

DB_HOST=localhost
DB_PORT=3306
DB_USER=carneiro
DB_PASSWORD=
DB_NAME=chiaradia_carneiro

# Gere com: openssl rand -hex 48
JWT_SECRET=

# Usuários iniciais do painel (o segundo é opcional)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_EMAIL_2=
ADMIN_PASSWORD_2=

# Dados de contato enviados aos portais
COMPANY_NAME="Carneiro & Chiaradia"
CONTACT_NAME=
CONTACT_EMAIL=
CONTACT_PHONE=

# Opcional
# UPLOADS_DIR=/var/lib/carneiro/uploads
# MAX_PROPERTIES=200
# CORS_ORIGIN=https://seudominio.com.br
